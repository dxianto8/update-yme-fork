-  --accent-hover:  #A30D25;
-  --border:        #D8E1EC;
-  --border-strong: #7C8AA0;
+  --tint:          #F1F3F5; /* cool gray sections */
+  --tint-2:        #E2E7EC;
+  --ink:           #1C252C;
+  --muted:         #55606A;
+  --primary:       var(--brand-steel);     /* links and icons */
+  --primary-deep:  var(--brand-charcoal);  /* headings */
+  --accent:        var(--brand-steel);     /* buttons and small labels */
+  --accent-hover:  #324C66;
+  --danger:        #A4262C;                /* form errors only */
+  --border:        #DDE3E6;
+  --border-strong: #8A949C;
   --on-dark:       #FFFFFF;
