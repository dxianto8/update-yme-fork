+  --brand-steel:    #3F5F7F;
   --photo-edge:  #292D39; /* the home photo fades up into this colour, and the bounce area above it matches */
+  --shade-rgb:   22,28,33; /* charcoal, for the fades over photos: rgba(var(--shade-rgb), .8) */
 
   /* semantic tokens */
